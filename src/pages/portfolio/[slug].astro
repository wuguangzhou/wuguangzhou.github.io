---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { slug as getSlug } from '../../lib/utils';

export async function getStaticPaths() {
  const items = await getCollection('portfolio');
  return items.map((i) => ({ params: { slug: i.id.replace(/\.md$/, '') } }));
}

const { slug } = Astro.params;
const item = (await getCollection('portfolio')).find((i) => i.id.replace(/\.md$/, '') === slug);
if (!item) return Astro.redirect('/404');

const contentHtml = marked.parse(item.body ?? '');
const all = (await getCollection('portfolio')).sort((a, b) => b.data.year - a.data.year);
const idx = all.findIndex((i) => getSlug(i) === slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
---

<BaseLayout title={`${item.data.title} · 周游`} description={item.data.description}>
  <section class="section" style="padding-top:160px">
    <div class="container">
      <a href="/portfolio" class="back-link reveal">← 返回作品列表</a>
      <div class="detail-meta reveal">
        <span class="badge">{item.data.category}</span>
        <span>{item.data.year}</span>
        {item.data.role && <span>角色：{item.data.role}</span>}
      </div>
      <h1 class="detail-title reveal">{item.data.title}</h1>
      <p class="detail-desc reveal">{item.data.description}</p>

      {item.data.techStack?.length > 0 && (
        <div class="detail-tags reveal">
          {item.data.techStack.map((t: string) => <span class="badge">{t}</span>)}
        </div>
      )}

      <div class="detail-links reveal">
        {item.data.url && (
          <a href={item.data.url} target="_blank" rel="noopener" class="text-link">访问项目 →</a>
        )}
        {item.data.repo && (
          <a href={item.data.repo} target="_blank" rel="noopener" class="text-link">GitHub →</a>
        )}
      </div>

      {item.body?.trim() && (
        <div class="prose reveal">
          <div set:html={contentHtml} />
        </div>
      )}
    </div>
  </section>

  <nav class="detail-nav container">
    {prev && <a href={`/portfolio/${getSlug(prev)}`} class="text-link">← {prev.data.title}</a>}
    {next && <a href={`/portfolio/${getSlug(next)}`} class="text-link">{next.data.title} →</a>}
  </nav>
</BaseLayout>

<style>
  .back-link { color: var(--color-text-dim); text-decoration: none; font-size: 0.875rem; }
  .detail-meta { display: flex; gap: 12px; align-items: center; margin: 24px 0 16px; font-size: 0.875rem; color: var(--color-text-dim); }
  .detail-title { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; margin-bottom: 16px; }
  .detail-desc { font-size: 1.1rem; color: var(--color-text-dim); margin-bottom: 24px; line-height: 1.7; }
  .detail-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 24px; }
  .detail-links { display: flex; gap: 24px; margin-bottom: 40px; }
  .prose { max-width: 680px; font-size: 1.05rem; line-height: 1.8; }
  .prose :global(h2) { font-family: var(--font-serif); font-size: 1.5rem; margin: 48px 0 16px; }
  .prose :global(p) { margin: 16px 0; }
  .prose :global(a) { color: var(--color-accent); }
  .detail-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding-bottom: 80px; }
  @media (max-width: 768px) { .detail-nav { grid-template-columns: 1fr; } }
</style>
