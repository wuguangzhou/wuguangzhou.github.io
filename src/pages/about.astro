---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const about = await getEntry('about', 'about');
if (!about) return Astro.redirect('/404');
---

<BaseLayout title="关于 · 周游" description={about.data.bio}>
  <section class="section" style="padding-top:160px">
    <div class="container about-layout">
      <div class="about-avatar reveal">
        <!-- 头像：更换 public/images/avatar/avatar.jpg 即可，无需改代码 -->
        <img src="/images/avatar/avatar.jpg" alt="周游的头像" width="128" height="128" />
      </div>
      <div class="about-text">
        <h1 class="about-name reveal">周游</h1>
        <p class="about-bio reveal">{about.data.extendedBio}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <blockquote class="motto reveal">{about.data.motto}</blockquote>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">技术栈</h2>
      <div class="tech-tags reveal">
        {about.data.techStack?.map((t: string) => <span class="badge tech-badge">{t}</span>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">目前在做什么</h2>
      <ul class="doing-list reveal">
        {about.data.currentlyDoing?.map((item: string) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about-layout { display: grid; grid-template-columns: 140px 1fr; gap: 48px; align-items: start; }
  @media (max-width: 768px) { .about-layout { grid-template-columns: 1fr; gap: 24px; } }
  .about-avatar { flex-shrink: 0; }
  .about-avatar img {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 2px solid var(--color-border);
    display: block;
  }
  .about-name { font-family: var(--font-serif); font-size: 2.5rem; font-weight: 700; margin-bottom: 12px; }
  .about-bio { font-size: 1.1rem; color: var(--color-text-dim); line-height: 1.8; }
  .motto { font-family: var(--font-serif); font-size: 1.4rem; font-style: italic; color: var(--color-text-dim); border-left: 3px solid var(--color-accent); padding: 24px 32px; margin: 0; max-width: 720px; line-height: 1.7; }
  .tech-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tech-badge { font-size: 0.8125rem; padding: 6px 14px; cursor: default; transition: background 0.2s ease; }
  .tech-badge:hover { background: var(--color-accent); color: #fff; border-color: var(--color-accent); }
  .doing-list { list-style: none; padding: 0; }
  .doing-list li { padding: 10px 0; font-size: 1.05rem; color: var(--color-text-dim); border-bottom: 1px solid var(--color-border); }
  .doing-list li:first-of-type { border-top: 1px solid var(--color-border); }
</style>
