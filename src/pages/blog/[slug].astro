---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { readingTime, slug as getSlug } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id.replace(/\.md$/, '') } }));
}

const { slug } = Astro.params;
const post = (await getCollection('blog')).find((p) => p.id.replace(/\.md$/, '') === slug);
if (!post) return Astro.redirect('/404');

const contentHtml = marked.parse(post.body ?? '');
const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = allPosts.findIndex((p) => getSlug(p) === slug);
const prev = idx > 0 ? allPosts[idx - 1] : null;
const next = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;
---

<BaseLayout title={`${post.data.title} · 周游`} description={post.data.description}>
  <article class="section" style="padding-top:160px">
    <div class="container">
      <div class="post-meta reveal">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {post.data.date.toISOString().slice(0, 10)}
        </time>
        <span>·</span>
        <span>{readingTime(post.body ?? '')} 分钟阅读</span>
      </div>
      <h1 class="post-title reveal">{post.data.title}</h1>
      {post.data.tags?.length > 0 && (
        <div class="post-tags reveal">
          {post.data.tags.map((t: string) => <span class="badge">{t}</span>)}
        </div>
      )}
    </div>
  </article>

  <div class="container">
    <div class="prose reveal">
      <div set:html={contentHtml} />
    </div>
  </div>

  <nav class="post-nav container">
    {prev && <a href={`/blog/${getSlug(prev)}`} class="text-link">← {prev.data.title}</a>}
    {next && <a href={`/blog/${getSlug(next)}`} class="text-link">{next.data.title} →</a>}
  </nav>
</BaseLayout>

<div id="progress-bar" style="position:fixed;top:0;left:0;height:2px;background:var(--color-accent);z-index:200;width:0%;transition:width 0.1s ease"></div>
<script>
  const bar = document.getElementById('progress-bar');
  window.addEventListener('scroll', () => {
    const h = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = h > 0 ? (window.scrollY / h * 100) + '%' : '0%';
  });
</script>

<style>
  .post-meta { font-size: 0.875rem; color: var(--color-text-dim); display: flex; gap: 8px; margin-bottom: 16px; }
  .post-title { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; line-height: 1.3; margin-bottom: 16px; }
  .post-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .prose { max-width: 680px; margin: 0 auto 80px; font-size: 1.05rem; line-height: 1.8; }
  .prose :global(h2) { font-family: var(--font-serif); font-size: 1.5rem; margin: 48px 0 16px; }
  .prose :global(h3) { font-size: 1.2rem; margin: 32px 0 12px; }
  .prose :global(p) { margin: 16px 0; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.875em; background: var(--color-code-bg); padding: 2px 6px; border-radius: 4px; }
  .prose :global(pre) { margin: 24px 0; border-radius: var(--radius-md); overflow-x: auto; }
  .prose :global(blockquote) { border-left: 3px solid var(--color-accent); padding-left: 20px; margin: 24px 0; color: var(--color-text-dim); font-style: italic; }
  .prose :global(a) { color: var(--color-accent); }
  .prose :global(img) { max-width: 100%; border-radius: var(--radius-md); margin: 24px 0; }
  .prose :global(ul), .prose :global(ol) { padding-left: 24px; margin: 16px 0; }
  .prose :global(li) { margin: 8px 0; }
  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 0 0 80px; }
  @media (max-width: 768px) { .post-nav { grid-template-columns: 1fr; } }
</style>
