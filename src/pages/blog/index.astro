---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slug } from '../../lib/utils';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const groups: Record<string, typeof posts> = {};
posts.forEach((p) => {
  const year = p.data.date.getFullYear().toString();
  (groups[year] ??= []).push(p);
});
const years = Object.keys(groups).sort((a, b) => parseInt(b) - parseInt(a));
---

<BaseLayout title="博客 · 周游" description="关于技术、设计与独立思考的文字。">
  <section class="section" style="padding-top:160px;padding-bottom:40px">
    <div class="container">
      <h1 class="page-title reveal">博客</h1>
      <p class="page-desc reveal" style="margin-bottom:0">关于技术、设计与独立思考的文字。</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      {years.map((year) => (
        <div class="year-group reveal">
          <h3 class="year-label">{year}</h3>
          {groups[year].map((post) => {
            const month = String(post.data.date.getMonth() + 1).padStart(2, '0');
            return (
              <a href={`/blog/${slug(post)}`} class="post-item">
                <span class="post-date">{month}</span>
                <div>
                  <div class="post-title">{post.data.title}</div>
                  <div class="post-desc">{post.data.description}</div>
                </div>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .year-group { margin-bottom: 32px; }
  .year-label { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 400; color: var(--color-accent); letter-spacing: 0.05em; margin-bottom: 12px; padding-bottom: 6px; border-bottom: 1px solid var(--color-border); }
  .post-item { display: grid; grid-template-columns: 60px 1fr; gap: 20px; padding: 16px 0; border-bottom: 1px solid var(--color-border); text-decoration: none; transition: padding 0.3s ease; }
  .post-item:first-of-type { border-top: 1px solid var(--color-border); }
  .post-item:hover { padding-left: 12px; }
  .post-date { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-text-faint); }
  .post-title { font-size: 1.05rem; font-weight: 500; color: var(--color-text); transition: color 0.3s ease; }
  .post-item:hover .post-title { color: var(--color-accent); }
  .post-desc { font-size: 0.875rem; color: var(--color-text-dim); margin-top: 4px; }
  @media (max-width: 768px) { .post-item { grid-template-columns: 1fr; gap: 6px; } }
</style>
